# Build outputs (rebuilt inside the container)
.next
out
dist
build

# Dependencies (reinstalled in the deps stage)
node_modules

# Local env — NEVER copy into the image. Secrets live only in EasyPanel.
.env
.env.local
.env.development
.env.production
.env*.local

# Git / IDE / OS
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Coverage / tests
coverage
.nyc_output
**/*.test.ts
**/*.test.tsx
vitest.config.ts

# Internal docs (not needed at runtime)
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
CHANGELOG.md

# Migrations run against Supabase, not in the container
supabase

# Claude / local config
.claude

# Docker files themselves
Dockerfile
.dockerignore

# Misc
*.tar.gz
*.zip
